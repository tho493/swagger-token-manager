{
  "manifest_version": 3,
  "name": "Swagger Token Manager",
  "version": "1.0.0",
  "description": "Quản lý và chuyển đổi token Swagger nhanh chóng mà không cần logout/login",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*/*swagger*", "*://*/*api-docs*", "*://*/*api/docs*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
